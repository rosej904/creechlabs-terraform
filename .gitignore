# Terraform state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform working directories
**/.terraform/
**/.terraform.lock.hcl

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
*backend.hcl
**/*.tfvars
**/*.tfvars.json
**/*backend.hcl


# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive outputs
*.pem
*.key