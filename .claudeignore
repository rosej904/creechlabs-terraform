# .claudeignore — best-effort only, not a hard security boundary
*.tfvars
*.tfstate
*.tfstate.backup
*.pem
*.key
id_rsa*
.env
.env.*
backend.hcl

# Python
**/*.pyc
**/__pycache__/
.venv/
venv/

# Terraform
.terraform/

# Build/dependency artifacts
**/build/
**/lambda/**/build/
**/package/
node_modules/
dist/
dist-ssr/

# Cursor's own cache
.cursor/

# Secrets - hard block from AI access (not just indexing)
**/*.tfvars
**/*.tfvars.json
**/*backend.hcl
*.pem
*.key
.env
.env.*