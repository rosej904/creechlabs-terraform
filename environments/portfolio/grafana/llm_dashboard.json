                                        "spec": {
                                            "editorMode": "code",
                                            "expr": "sum(gen_ai_usage_cache_read_tokens{service_name=\"cl-portfolio-chat\"}) \r\n/ \r\nsum(gen_ai_usage_input_tokens{service_name=\"cl-portfolio-chat\"}) \r\n* 100",
