                                            "name": "loki"
                                        },
                                        "spec": {
                                            "direction": "backward",
                                            "editorMode": "code",
                                            "expr": "{service_name=\"cl-portfolio-chat\"} | logfmt | line_format \"{{.gen_ai_prompt_preview}} | {{.gen_ai_usage_total_tokens}} tokens\"",
