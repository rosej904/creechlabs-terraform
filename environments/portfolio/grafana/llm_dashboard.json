        "panel-5": {
            "kind": "Panel",
            "spec": {
                "id": 5,
                "title": "Prompt Cache Hit Rate",
                "description": "Tracks system prompt cache efficiency. Cache TTL is 5 minutes — sustained traffic keeps this high; sparse traffic results in cold starts.",
